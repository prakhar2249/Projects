when "Hypertension" = 1 and "Alcoholism" = 1 then 'Hypertension & Alcoholism'
when "Alcoholism" = 1 and "Diabetes" = 1 then 'Alcoholism & Diabetes'
when "Hypertension" = 1 then 'Hypertension'
when "Diabetes" = 1 then 'Diabetes'
when "Alcoholism" = 1 then 'Alcoholism'
else 'Neither'
end as chronic_Disease, 

case
when "Hypertension" = 1 and "Diabetes" = 1 and "Alcoholism" = 1 then 1
when "Hypertension" = 1 and "Diabetes" = 1 then 2
when "Hypertension" = 1 and "Alcoholism" = 1 then 3
when "Alcoholism" = 1 and "Diabetes" = 1 then 4
when "Hypertension" = 1 then 5
when "Diabetes" = 1 then 6
when "Alcoholism" = 1 then 7
else 8
end as sort_order, ---Sorting

"No-show"

