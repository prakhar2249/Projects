No show vs Age vs Neigh:

select 
"Neighbourhood",
Case
when "Age" between 0 and 15 then '0-15 Yrs'
when "Age" between 16 and 30 then '16-30 Yrs'
when "Age" between 31 and 45 then '31-45 Yrs'
when "Age" between 46 and 60 then '46-60 Yrs'
when "Age" between 61 and 75 then '61-75 Yrs'
Else '76+ Yrs'
end "Age_group",
count(*) as Total_appointment,
Sum(case when "No-show" = 1 then 1 else 0 end) as no_total_show,
Round(100* Sum(case when "No-show" = 1 then 1 else 0 end)/count(*), 2) as percent_rate_no_show
from patient_appointment
group by  "Neighbourhood" , 
CASE
           WHEN "Age" BETWEEN 0 AND 15 THEN '0-15 Yrs'
           WHEN "Age" BETWEEN 16 AND 30 THEN '16-30 Yrs'
           WHEN "Age" BETWEEN 31 AND 45 THEN '31-45 Yrs'
           WHEN "Age" BETWEEN 46 AND 60 THEN '46-60 Yrs'
           WHEN "Age" BETWEEN 61 AND 75 THEN '61-75 Yrs'
           ELSE '76+ Yrs'
         END
order by "Neighbourhood", "Age_group";




