No show v/s Lead time

with lead_time_data as (select 
"AppointmentID",
"AppointmentDay",
"ScheduledDay",
"AppointmentDay" - "ScheduledDay" as lead_time,
"No-show"
from patient_appointment)
select
Case 
when "lead_time" < 0 then 'Invalid'
when "lead_time" between 0 AND 10 then '0-10'
when "lead_time" between 11 and 20 then '11-20'
when "lead_time" between 21 and 30 then '21-30'
when "lead_time" between 31 and 40 then '31-40'
when "lead_time" between 41 and 50 then '41-50'
when "lead_time" between 51 and 60 then '51-60'
else '60+'
end Lead_time_group,
count(*) as AppointmentID,
Sum(case when "No-show" = 1 then 1 else 0 end) as Total_no_show,
Round(100*Sum(case when "No-show" = 1 then 1 else 0 end)/count(*), 2) as percent_rate_no_show
from lead_time_data
group by Lead_time_group
order by Lead_time_group;

 

No show v/s Weekday

with Weekday_Q as (select extract(Dow from "AppointmentDay") AS weekday, "No-show"
from patient_Appointment)
select case 
when weekday = 1 then 'Monday'
when weekday = 2 then 'Tuesday'
when weekday = 3 then 'Wednesday'
when weekday = 4 then 'Thursday'
when weekday = 5 then 'Friday'
when weekday = 6 then 'Saturday'
else 'Sunday'
end Weekday_name,
count(*) as Total_appointments,
Sum(case when "No-show" = 1 then 1 else 0 end) as total_no_show,
ROund(100* Sum(case when "No-show" = 1 then 1 else 0 end)/count(*), 2) as rate_percent_no_show
from Weekday_Q
Group by weekday
order by weekday;

 
